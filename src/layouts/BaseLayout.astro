---
import '../styles/global.css';
import { DEFAULT_DESCRIPTION } from '../config';
import { buildCanonical, buildTitle } from '../lib/seo';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
interface Props { title?: string; description?: string; canonicalPath: string; image?: string; jsonLd?: Record<string, unknown> | Record<string, unknown>[]; home?: boolean }
const { title, description = DEFAULT_DESCRIPTION, canonicalPath, image = '/og/workbench.svg', jsonLd, home = false } = Astro.props;
const pageTitle = buildTitle(title); const canonical = buildCanonical(canonicalPath); const socialImage = buildCanonical(image);
---
<!doctype html><html lang="es"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="generator" content={Astro.generator} /><meta name="theme-color" content="#111315" />
  <title>{pageTitle}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" /><meta property="og:locale" content="es_ES" /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} />
  {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head><body><a class="skip-link" href="#main-content">Saltar al contenido</a><SiteHeader {home} /><main id="main-content"><slot /></main><SiteFooter /></body></html>
