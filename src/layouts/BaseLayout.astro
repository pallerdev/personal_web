---
import "../styles/global.css";
import { OG_IMAGE } from "../config";
import { htmlLang, ogLocale, type Locale, type RouteKey } from "../i18n/config";
import { buildAlternates, buildCanonical, buildTitle } from "../lib/seo";
import { metaDescription } from "../content/site";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  locale,
  routeKey,
  title,
  description = metaDescription[locale],
  image = OG_IMAGE[locale],
  jsonLd,
} = Astro.props;

const pageTitle = buildTitle(title, locale);
const canonical = buildCanonical(Astro.url.pathname);
const socialImage = buildCanonical(image);
const alternates = buildAlternates(routeKey);
const structuredData = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f1216"
      media="(prefers-color-scheme: dark)"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      alternates.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:site_name" content="Pablo Aller" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {
      structuredData.map((entry) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(entry)}
        />
      ))
    }

    {/* Applies the stored theme before first paint so the page never flashes. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || stored === "light") {
          document.documentElement.dataset.theme = stored;
        }
      } catch {
        /* Private mode and blocked storage both fall back to the system theme. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {locale === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <SiteHeader {locale} {routeKey} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter {locale} />
  </body>
</html>
