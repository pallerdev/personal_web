---
interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = home ? '' : '/';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Pablo Aller, inicio"><span class="brand-mark" aria-hidden="true">PA</span><span>Pablo Aller</span></a>
    <nav aria-label="Navegación principal">
      <a href={`${base}#work`}>Trabajo</a><a href={`${base}#experience`}>Experiencia</a><a href={`${base}#about`}>Sobre mí</a><a class="nav-contact" href={`${base}#contact`}>Contacto</a>
    </nav>
  </div>
</header>
