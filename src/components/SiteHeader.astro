---
import {
  otherLocale,
  routeFor,
  type Locale,
  type RouteKey,
} from "../i18n/config";
import { identity, nav } from "../content/site";

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;

const home = routeFor("home", locale);
const other = otherLocale(locale);
const otherHref = routeFor(routeKey, other);

const copy = {
  es: {
    brandLabel: "Pablo Aller, ir al inicio",
    navLabel: "Navegación principal",
    switchLanguage: "Ver esta página en inglés",
  },
  en: {
    brandLabel: "Pablo Aller, back to home",
    navLabel: "Main navigation",
    switchLanguage: "View this page in Spanish",
  },
}[locale];

/* On a case-study page the section links have to point back at the home page. */
const sectionBase = routeKey === "home" ? "" : home;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={home} aria-label={copy.brandLabel}>
      <span class="brand-mark" aria-hidden="true">{identity.initials}</span>
      <span>{identity.name}</span>
    </a>

    <nav class="site-nav" aria-label={copy.navLabel}>
      {
        nav[locale].map((item) => (
          <a href={`${sectionBase}${item.hash}`}>{item.label}</a>
        ))
      }
    </nav>

    <div class="header-tools">
      <div class="switches">
        <a class="switch" href={otherHref} hreflang={other} lang={other}>
          <span class="sr-only">{copy.switchLanguage}</span>
          <span aria-hidden="true">{other.toUpperCase()}</span>
        </a>

        <button
          class="switch"
          type="button"
          id="theme-toggle"
          aria-pressed="false"
          hidden
        >
          <span class="sr-only" id="theme-toggle-label"></span>
          <svg
            class="switch-icon"
            data-theme-icon="light"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="3.1"></circle>
            <path
              d="M8 1.1v1.6M8 13.3v1.6M1.1 8h1.6M13.3 8h1.6M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1"
            ></path>
          </svg>
          <svg
            class="switch-icon is-hidden"
            data-theme-icon="dark"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M13.4 10.1A5.7 5.7 0 0 1 5.9 2.6a5.8 5.8 0 1 0 7.5 7.5Z"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  /**
   * The theme toggle is the only client-side script on the site. It starts
   * hidden so a visitor without JavaScript is never shown a control that
   * cannot work — the system theme applies on its own in that case.
   */
  const button = document.getElementById("theme-toggle");
  const label = document.getElementById("theme-toggle-label");
  const sun = document.querySelector<SVGElement>('[data-theme-icon="light"]');
  const moon = document.querySelector<SVGElement>('[data-theme-icon="dark"]');

  if (button && label && sun && moon) {
    const lang = document.documentElement.lang === "en" ? "en" : "es";
    const copy = {
      es: { toLight: "Cambiar a tema claro", toDark: "Cambiar a tema oscuro" },
      en: { toLight: "Switch to light theme", toDark: "Switch to dark theme" },
    }[lang];

    const isDark = () =>
      (document.documentElement.dataset.theme ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light")) === "dark";

    const render = () => {
      const dark = isDark();
      sun.classList.toggle("is-hidden", dark);
      moon.classList.toggle("is-hidden", !dark);
      label.textContent = dark ? copy.toLight : copy.toDark;
      button.setAttribute("aria-pressed", String(dark));
    };

    button.hidden = false;
    render();

    button.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* Nothing to persist to; the choice still applies to this page. */
      }
      render();
    });

    /* Follow the system while no explicit choice has been stored. */
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if (!document.documentElement.dataset.theme) render();
      });
  }
</script>
