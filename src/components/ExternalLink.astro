---
interface Props {
  href: string;
  class?: string;
  /** Language of the page being linked to, when it is not the current one. */
  lang?: string;
}

const { href, class: className, lang } = Astro.props;
---

<a {href} class={className} {lang} target="_blank" rel="noreferrer">
  <slot />
  <span aria-hidden="true">↗</span>
</a>
